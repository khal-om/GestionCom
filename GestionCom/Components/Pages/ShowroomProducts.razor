@page "/showroom/produits"
@using GestionCom.Data
@using GestionCom.Features.Showroom.Entities
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IWebHostEnvironment Environment

@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

<PageTitle>Produits du showroom</PageTitle>

<div class="showroom-admin-page">
    <header class="showroom-admin-heading">
        <div>
            <p class="showroom-eyebrow">BOUTIQUE PUBLIQUE · SHOP.FEDNAD.COM</p>
            <h1>Produits du showroom</h1>
            <p>Gérez les produits présentés au public. Ces fiches sont indépendantes du stock et des ventes GestionCom.</p>
        </div>
        <button type="button" class="showroom-primary-button" @onclick="NewProduct">+ Nouveau produit</button>
    </header>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="showroom-alert @(isError ? "is-error" : "is-success")">@message</div>
    }

    @if (isLoading)
    {
        <div class="showroom-empty-state">Chargement des produits…</div>
    }
    else
    {
        <div class="showroom-admin-layout">
            <section class="showroom-admin-panel showroom-product-list-panel">
                <div class="showroom-panel-heading">
                    <div><h2>Catalogue</h2><span>@products.Count fiche(s)</span></div>
                    <input class="showroom-search" placeholder="Rechercher un produit…" @bind="searchText" @bind:event="oninput" aria-label="Rechercher un produit" />
                </div>

                @if (!FilteredProducts.Any())
                {
                    <div class="showroom-empty-state">Aucun produit trouvé. Créez votre première fiche showroom.</div>
                }
                else
                {
                    <div class="showroom-product-list">
                        @foreach (var product in FilteredProducts)
                        {
                            <article class="showroom-product-row" @key="product.Id">
                                @if (!string.IsNullOrWhiteSpace(product.Images.FirstOrDefault(i => i.IsPrimary)?.ImagePath))
                                {
                                    <img class="showroom-product-thumb" src="@product.Images.First(i => i.IsPrimary).ImagePath" alt="" />
                                }
                                else
                                {
                                    <div class="showroom-product-thumb showroom-no-image">Photo</div>
                                }
                                <div class="showroom-product-row-info">
                                    <strong>@product.NameFr</strong>
                                    <span>@product.Brand.NameFr · @product.PriceTnd.ToString("0.00") TND</span>
                                    <small class="@(product.IsPublished ? "showroom-status-live" : "showroom-status-draft")">@(product.IsPublished ? "Publié" : "Brouillon")</small>
                                </div>
                                <div class="showroom-row-actions">
                                    <button type="button" class="showroom-text-button" @onclick="() => EditProduct(product.Id)">Modifier</button>
                                    <button type="button" class="showroom-text-button showroom-delete-button" @onclick="() => DeleteProductAsync(product.Id)">Supprimer</button>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>

            @if (isEditorOpen)
            {
                <section class="showroom-admin-panel showroom-editor-panel">
                    <div class="showroom-panel-heading">
                        <div><h2>@(editingId.HasValue ? "Modifier la fiche" : "Nouvelle fiche")</h2><span>Informations en français</span></div>
                        <button type="button" class="showroom-close-button" @onclick="CancelEdit" aria-label="Fermer">×</button>
                    </div>

                    <EditForm Model="model" OnValidSubmit="SaveProductAsync" FormName="showroom-product-editor" class="showroom-editor-form">
                        <DataAnnotationsValidator />
                        <div class="showroom-form-grid">
                            <div class="showroom-field">
                                <label for="showroom-brand">Marque *</label>
                                <div class="showroom-input-with-action">
                                    <InputSelect id="showroom-brand" class="showroom-input"
                                                 @bind-Value="model.BrandId"
                                                 @bind-Value:after="OnBrandChangedAsync">
                                        @foreach (var brand in brands)
                                        {
                                            <option value="@brand.Id">@brand.NameFr</option>
                                        }
                                    </InputSelect>
                                    <button type="button" class="showroom-secondary-button"
                                             @onclick='() => OpenLookupModal("Brand")'>
                                        + Ajouter
                                    </button>
                                </div>
                            </div>
                            <div class="showroom-field">
                                <label for="showroom-price">Prix public (TND) *</label>
                                <InputNumber id="showroom-price" class="showroom-input" @bind-Value="model.PriceTnd" step="0.001" min="0" />
                            </div>
                            <div class="showroom-field">
                                <label for="showroom-name-fr">Nom *</label>
                                <InputText id="showroom-name-fr" class="showroom-input" @bind-Value="model.NameFr" />
                            </div>
                            
                            <div class="showroom-field">
                                <label for="showroom-range">Gamme</label>
                                <div class="showroom-input-with-action">
                                    <InputSelect TValue="int?" id="showroom-range" class="showroom-input"
                                                 @bind-Value="model.RangeId">
                                        <option value="">Aucune gamme</option>
                                        @foreach (var range in ranges.Where(r => r.BrandId == model.BrandId))
                                        {
                                            <option value="@range.Id">@range.NameFr</option>
                                        }
                                    </InputSelect>
                                    <button type="button" class="showroom-secondary-button"
                                             @onclick='() => OpenLookupModal("Range")'>
                                        + Ajouter
                                    </button>
                                </div>
                            </div>
                            <div class="showroom-field">
                                <label for="showroom-size">Contenance / format</label>
                                <div class="showroom-input-with-action">
                                    <InputSelect id="showroom-size" class="showroom-input" @bind-Value="model.Size">
                                        <option value="">Choisir un format</option>
                                        @foreach (var size in sizes)
                                        {
                                            <option value="@size">@size</option>
                                        }
                                    </InputSelect>
                                    <button type="button" class="showroom-secondary-button"
                                             @onclick='() => OpenLookupModal("Size")'>
                                        + Ajouter
                                    </button>
                                </div>
                            </div>
                            <div class="showroom-field">
                                <label for="showroom-category-fr">Catégorie (FR)</label>
                                <InputText id="showroom-category-fr" class="showroom-input" @bind-Value="model.CategoryFr" placeholder="Ex. Shampooing" />
                            </div>
                            
                            
                            <div class="showroom-field">
                                <label for="showroom-hair-type-fr">Type de cheveux</label>
                                <div class="showroom-input-with-action">
                                    <InputSelect id="showroom-hair-type-fr" class="showroom-input"
                                                 @bind-Value="model.HairTypeFr">
                                        <option value="">Choisir un type</option>
                                        @foreach (var hairType in hairTypes)
                                        {
                                            <option value="@hairType">@hairType</option>
                                        }
                                    </InputSelect>
                                    <button type="button" class="showroom-secondary-button"
                                             @onclick='() => OpenLookupModal("HairType")'>
                                        + Ajouter
                                    </button>
                                </div>
                            </div>
                            
                        </div>

                        <div class="showroom-field">
                            <label for="showroom-short-fr">Description courte (FR)</label>
                            <InputTextArea id="showroom-short-fr" class="showroom-input" @bind-Value="model.ShortDescriptionFr" rows="2" />
                        </div>
                        
                        <div class="showroom-field">
                            <label for="showroom-description-fr">Description complète</label>
                            <InputTextArea id="showroom-description-fr" class="showroom-input" @bind-Value="model.DescriptionFr" rows="4" />
                        </div>
                        <div class="showroom-field">
                            <label for="showroom-how-to-use-fr">Conseils d'utilisation</label>
                            <InputTextArea id="showroom-how-to-use-fr" class="showroom-input" @bind-Value="model.HowToUseFr" rows="3" />
                        </div>
                        <div class="showroom-field">
                            <label for="showroom-ingredients-fr">Ingrédients</label>
                            <InputTextArea id="showroom-ingredients-fr" class="showroom-input" @bind-Value="model.IngredientsFr" rows="3" />
                        </div>
                        

                        <div class="showroom-field">
                            <label for="showroom-photos">Photos du produit</label>
                            <InputFile id="showroom-photos" OnChange="OnPhotosSelected" multiple accept="image/jpeg,image/png,image/webp" class="showroom-file-input" />
                            <small>JPG, PNG ou WebP · 5 Mo maximum par photo · 10 photos maximum par produit. Vous pouvez sélectionner plusieurs fichiers à la fois ou répéter la sélection pour en ajouter.</small>
                            @if (selectedFileNames.Count > 0)
                            {
                                <small>@selectedFileNames.Count photo(s) prête(s) à être ajoutée(s) : @string.Join(", ", selectedFileNames)</small>
                                <button type="button" class="showroom-text-button" @onclick="ClearSelectedPhotos">Effacer la sélection</button>
                            }
                        </div>
                        @if (currentImages.Count > 0)
                        {
                            <div class="showroom-image-gallery">
                                <strong>Photos enregistrées</strong>
                                <div class="showroom-image-gallery-grid">
                                    @foreach (var image in currentImages.OrderByDescending(i => i.IsPrimary).ThenBy(i => i.SortOrder))
                                    {
                                        <div class="showroom-image-card" @key="image.Id">
                                            <img src="@image.ImagePath" alt="@(image.AltTextFr ?? model.NameFr)" />
                                            <div>
                                                <span>@(image.IsPrimary ? "Photo principale" : "Photo secondaire")</span>
                                                @if (!image.IsPrimary)
                                                {
                                                    <button type="button" class="showroom-text-button" @onclick="() => SetPrimaryImageAsync(image.Id)">Définir comme principale</button>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <div class="showroom-checkbox-row">
                            <label><InputCheckbox @bind-Value="model.IsAvailable" /> Disponible</label>
                            <label><InputCheckbox @bind-Value="model.IsFeatured" /> Mise en avant</label>
                            <label><InputCheckbox @bind-Value="model.IsPublished" /> Publier sur le showroom</label>
                        </div>
                        <div class="showroom-editor-actions">
                            <button type="button" class="showroom-secondary-button" @onclick="CancelEdit">Annuler</button>
                            <button type="submit" class="showroom-primary-button" disabled="@isSaving">@(isSaving ? "Enregistrement…" : "Enregistrer la fiche")</button>
                        </div>
                    </EditForm>
                </section>
            }

            @if (isLookupModalOpen)
            {
                <div class="showroom-modal-backdrop">
                    <section class="showroom-admin-panel showroom-lookup-modal">
                        <div class="showroom-panel-heading">
                            <h2>@LookupModalTitle</h2>
                            <button type="button" class="showroom-close-button"
                                    @onclick="CloseLookupModal" aria-label="Fermer">
                                ×
                            </button>
                        </div>

                        <div class="showroom-field">
                            <label for="showroom-new-lookup-value">@LookupModalLabel</label>
                            <input id="showroom-new-lookup-value"
                                   class="showroom-input"
                                   @bind="newLookupValue"
                                   @bind:event="oninput"
                                   maxlength="160"
                                   autofocus />
                        </div>

                        @if (!string.IsNullOrWhiteSpace(lookupError))
                        {
                            <div class="showroom-alert is-error">@lookupError</div>
                        }

                        <div class="showroom-editor-actions">
                            <button type="button" class="showroom-secondary-button"
                                    @onclick="CloseLookupModal">
                                Annuler
                            </button>
                            <button type="button" class="showroom-primary-button"
                                    @onclick="SaveLookupAsync" disabled="@isLookupSaving">
                                @(isLookupSaving ? "Enregistrement…" : "Ajouter")
                            </button>
                        </div>
                    </section>
                </div>
            }
        </div>
    }
</div>

@code {
    private const long MaxPhotoBytes = 5 * 1024 * 1024;
    private const int MaxPhotoCount = 10;
    private List<ShowroomProduct> products = new();
    private List<ShowroomBrand> brands = new();
    private List<ShowroomRange> ranges = new();
    private List<string> sizes = new();
    private List<string> hairTypes = new();
    private ProductEditorModel model = new();
    private List<IBrowserFile> selectedPhotos = new();
    private List<string> selectedFileNames = new();
    private List<ShowroomProductImage> currentImages = new();
    private string? message;
    private string searchText = string.Empty;
    private bool isLoading = true;
    private bool isSaving;
    private bool isError;
    private bool isEditorOpen;
    private bool isLookupModalOpen;
    private bool isLookupSaving;
    private int? editingId;
    private string? lookupType;
    private string newLookupValue = string.Empty;
    private string? lookupError;

    private string LookupModalTitle => lookupType switch
    {
        "Brand" => "Ajouter une marque",
        "Range" => "Ajouter une gamme",
        "Size" => "Ajouter un format",
        "HairType" => "Ajouter un type de cheveux",
        _ => "Ajouter une valeur"
    };

    private string LookupModalLabel => lookupType switch
    {
        "Brand" => "Nom de la marque",
        "Range" => "Nom de la gamme",
        "Size" => "Format / contenance",
        "HairType" => "Type de cheveux",
        _ => "Nom"
    };

    private IEnumerable<ShowroomProduct> FilteredProducts => products.Where(p =>
        string.IsNullOrWhiteSpace(searchText) ||
        p.NameFr.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
        
        p.Brand.NameFr.Contains(searchText, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        brands = await db.ShowroomBrands.AsNoTracking().OrderBy(b => b.SortOrder).ThenBy(b => b.NameFr).ToListAsync();
        if (brands.Count == 0)
        {
            var kemon = new ShowroomBrand { Slug = "kemon", NameFr = "Kemon", SortOrder = 1, IsPublished = true, CreatedAt = DateTime.UtcNow };
            var actyva = new ShowroomBrand { Slug = "actyva", NameFr = "Actyva", SortOrder = 2, IsPublished = true, CreatedAt = DateTime.UtcNow };
            db.ShowroomBrands.AddRange(kemon, actyva);
            await db.SaveChangesAsync();
            brands = await db.ShowroomBrands.AsNoTracking().OrderBy(b => b.SortOrder).ToListAsync();
        }
        ranges = await db.ShowroomRanges.AsNoTracking().OrderBy(r => r.SortOrder).ThenBy(r => r.NameFr).ToListAsync();
        var options = await db.ShowroomProductOptions.AsNoTracking().ToListAsync();
        sizes = options.Where(o => o.OptionType == "Size").Select(o => o.ValueFr).OrderBy(v => v).ToList();
        hairTypes = options.Where(o => o.OptionType == "HairType").Select(o => o.ValueFr).OrderBy(v => v).ToList();
        products = await db.ShowroomProducts.AsNoTracking()
            .Include(p => p.Brand).Include(p => p.Range).Include(p => p.Images)
            .OrderBy(p => p.SortOrder).ThenByDescending(p => p.CreatedAt).ToListAsync();
        isLoading = false;
    }

    private void NewProduct()
    {
        editingId = null;
        model = new ProductEditorModel { BrandId = brands.FirstOrDefault()?.Id ?? 0, IsAvailable = true };
        selectedPhotos.Clear();
        selectedFileNames.Clear();
        currentImages.Clear();
        message = null;
        isEditorOpen = true;
    }

    private void EditProduct(int id)
    {
        var product = products.First(p => p.Id == id);
        editingId = id;
        model = new ProductEditorModel
        {
            BrandId = product.BrandId, NameFr = product.NameFr, RangeId = product.RangeId,
            PriceTnd = product.PriceTnd, Size = product.Size, CategoryFr = product.CategoryFr,
            HairNeedFr = product.HairNeedFr, HairTypeFr = product.HairTypeFr,
            ShortDescriptionFr = product.ShortDescriptionFr,
            DescriptionFr = product.DescriptionFr, HowToUseFr = product.HowToUseFr,
            IngredientsFr = product.IngredientsFr, 
            IsAvailable = product.IsAvailable, IsFeatured = product.IsFeatured, IsPublished = product.IsPublished
        };
        currentImages = product.Images.OrderByDescending(i => i.IsPrimary).ThenBy(i => i.SortOrder).ToList();
        selectedPhotos.Clear();
        selectedFileNames.Clear();
        message = null;
        isEditorOpen = true;
    }

    private Task OnBrandChangedAsync()
    {
        if (model.RangeId.HasValue && ranges.All(r => r.Id != model.RangeId.Value || r.BrandId != model.BrandId))
            model.RangeId = null;
        return Task.CompletedTask;
    }

    private void OpenLookupModal(string type)
    {
        lookupType = type;
        newLookupValue = string.Empty;
        lookupError = null;
        isLookupModalOpen = true;
    }

    private void CloseLookupModal()
    {
        isLookupModalOpen = false;
        lookupType = null;
        newLookupValue = string.Empty;
        lookupError = null;
    }

    private async Task SaveLookupAsync()
    {
        var value = newLookupValue.Trim();
        if (string.IsNullOrWhiteSpace(value))
        {
            lookupError = "Saisissez une valeur.";
            return;
        }

        if (value.Length > 160)
        {
            lookupError = "La valeur ne peut pas dépasser 160 caractères.";
            return;
        }

        isLookupSaving = true;
        lookupError = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            switch (lookupType)
            {
                case "Brand":
                {
                    if (await db.ShowroomBrands.AnyAsync(b => b.NameFr.ToLower() == value.ToLower()))
                    {
                        lookupError = "Cette marque existe déjà.";
                        return;
                    }

                    var brand = new ShowroomBrand
                    {
                        NameFr = value,
                        Slug = await MakeUniqueEntitySlugAsync(db, value, "brand"),
                        SortOrder = await db.ShowroomBrands.CountAsync() + 1,
                        IsPublished = true,
                        CreatedAt = DateTime.UtcNow
                    };
                    db.ShowroomBrands.Add(brand);
                    await db.SaveChangesAsync();
                    brands = await db.ShowroomBrands.AsNoTracking().OrderBy(b => b.SortOrder).ThenBy(b => b.NameFr).ToListAsync();
                    model.BrandId = brand.Id;
                    model.RangeId = null;
                    break;
                }
                case "Range":
                {
                    if (model.BrandId <= 0)
                    {
                        lookupError = "Sélectionnez d’abord une marque.";
                        return;
                    }

                    if (await db.ShowroomRanges.AnyAsync(r => r.BrandId == model.BrandId && r.NameFr.ToLower() == value.ToLower()))
                    {
                        lookupError = "Cette gamme existe déjà pour cette marque.";
                        return;
                    }

                    var range = new ShowroomRange
                    {
                        BrandId = model.BrandId,
                        NameFr = value,
                        Slug = await MakeUniqueRangeSlugAsync(db, value, model.BrandId),
                        SortOrder = await db.ShowroomRanges.CountAsync(r => r.BrandId == model.BrandId) + 1,
                        IsPublished = true,
                        CreatedAt = DateTime.UtcNow
                    };
                    db.ShowroomRanges.Add(range);
                    await db.SaveChangesAsync();
                    ranges = await db.ShowroomRanges.AsNoTracking().OrderBy(r => r.SortOrder).ThenBy(r => r.NameFr).ToListAsync();
                    model.RangeId = range.Id;
                    break;
                }
                case "Size":
                case "HairType":
                {
                    var optionType = lookupType;
                    var normalized = NormalizeLookupValue(value);
                    if (await db.ShowroomProductOptions.AnyAsync(o => o.OptionType == optionType && o.NormalizedValue == normalized))
                    {
                        lookupError = "Cette valeur existe déjà.";
                        return;
                    }

                    db.ShowroomProductOptions.Add(new ShowroomProductOption
                    {
                        OptionType = optionType,
                        ValueFr = value,
                        NormalizedValue = normalized,
                        CreatedAt = DateTime.UtcNow
                    });
                    await db.SaveChangesAsync();
                    var values = await db.ShowroomProductOptions.AsNoTracking()
                        .Where(o => o.OptionType == optionType).OrderBy(o => o.ValueFr)
                        .Select(o => o.ValueFr).ToListAsync();
                    if (optionType == "Size") sizes = values;
                    else hairTypes = values;
                    if (optionType == "Size") model.Size = value;
                    else model.HairTypeFr = value;
                    break;
                }
                default:
                    lookupError = "Type de valeur non reconnu.";
                    return;
            }

            CloseLookupModal();
        }
        catch (Exception ex)
        {
            lookupError = $"Ajout impossible : {ex.GetBaseException().Message}";
        }
        finally
        {
            isLookupSaving = false;
        }
    }

    private void CancelEdit()
    {
        isEditorOpen = false;
        editingId = null;
        selectedPhotos.Clear();
        selectedFileNames.Clear();
    }

    private Task OnPhotosSelected(InputFileChangeEventArgs args)
    {
        try
        {
            var newlySelectedPhotos = args.GetMultipleFiles(MaxPhotoCount).ToList();

            if (currentImages.Count + selectedPhotos.Count + newlySelectedPhotos.Count > MaxPhotoCount)
            {
                SetMessage($"Un produit peut contenir au maximum {MaxPhotoCount} photos au total. Votre sélection précédente a été conservée.", true);
                return Task.CompletedTask;
            }

            selectedPhotos.AddRange(newlySelectedPhotos);
            selectedFileNames = selectedPhotos.Select(photo => photo.Name).ToList();
            message = null;
        }
        catch (InvalidOperationException)
        {
            SetMessage($"Sélectionnez au maximum {MaxPhotoCount} photos à la fois.", true);
        }

        return Task.CompletedTask;
    }

    private void ClearSelectedPhotos()
    {
        selectedPhotos.Clear();
        selectedFileNames.Clear();
    }

    private async Task SetPrimaryImageAsync(int imageId)
    {
        if (!editingId.HasValue) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var images = await db.ShowroomProductImages
            .Where(image => image.ProductId == editingId.Value)
            .ToListAsync();

        foreach (var image in images)
            image.IsPrimary = image.Id == imageId;

        await db.SaveChangesAsync();
        await LoadAsync();
        currentImages = products.First(product => product.Id == editingId.Value)
            .Images.OrderByDescending(image => image.IsPrimary)
            .ThenBy(image => image.SortOrder)
            .ToList();
    }

    private async Task SaveProductAsync()
    {
        if (string.IsNullOrWhiteSpace(model.NameFr))
        {
            SetMessage("Le nom doit être renseigné en français.", true);
            return;
        }
        if (model.PriceTnd < 0 || model.BrandId <= 0)
        {
            SetMessage("Vérifiez la marque et le prix.", true);
            return;
        }
        if (currentImages.Count + selectedPhotos.Count > MaxPhotoCount)
        {
            SetMessage($"Un produit peut contenir au maximum {MaxPhotoCount} photos au total.", true);
            return;
        }
        if (selectedPhotos.Any(photo => photo.Size > MaxPhotoBytes || !IsAllowedImage(photo.ContentType)))
        {
            SetMessage("Chaque photo doit être au format JPG, PNG ou WebP et ne pas dépasser 5 Mo.", true);
            return;
        }

        isSaving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            ShowroomProduct product;
            if (editingId.HasValue)
            {
                product = await db.ShowroomProducts.Include(p => p.Images).FirstAsync(p => p.Id == editingId.Value);
                product.UpdatedAt = DateTime.UtcNow;
            }
            else
            {
                product = new ShowroomProduct { CreatedAt = DateTime.UtcNow, SortOrder = products.Count + 1 };
                db.ShowroomProducts.Add(product);
            }

            product.BrandId = model.BrandId;
            var range = model.RangeId.HasValue
                ? await db.ShowroomRanges.FirstOrDefaultAsync(r => r.Id == model.RangeId.Value && r.BrandId == model.BrandId)
                : null;
            if (model.RangeId.HasValue && range is null)
            {
                SetMessage("La gamme sélectionnée n’est pas valide pour cette marque.", true);
                return;
            }
            product.Range = range;
            product.RangeId = range?.Id;
            product.NameFr = model.NameFr.Trim();
            product.Slug = await MakeUniqueSlugAsync(db, model.NameFr, editingId);
            product.PriceTnd = model.PriceTnd;
            product.Size = Clean(model.Size);
            product.CategoryFr = Clean(model.CategoryFr);
            product.HairNeedFr = Clean(model.HairNeedFr);
            product.HairTypeFr = Clean(model.HairTypeFr);
            product.ShortDescriptionFr = Clean(model.ShortDescriptionFr);
            product.DescriptionFr = Clean(model.DescriptionFr);
            product.HowToUseFr = Clean(model.HowToUseFr);
            product.IngredientsFr = Clean(model.IngredientsFr);
            product.IsAvailable = model.IsAvailable;
            product.IsFeatured = model.IsFeatured;
            product.IsPublished = model.IsPublished;

            await db.SaveChangesAsync();

            if (selectedPhotos.Count > 0)
            {
                var uploadFolder = Path.Combine(Environment.WebRootPath ?? Path.Combine(Environment.ContentRootPath, "wwwroot"), "uploads", "showroom");
                Directory.CreateDirectory(uploadFolder);

                var hasPrimaryImage = product.Images.Any(image => image.IsPrimary);
                var nextSortOrder = product.Images.Count == 0 ? 0 : product.Images.Max(image => image.SortOrder) + 1;

                foreach (var photo in selectedPhotos)
                {
                    var extension = photo.ContentType.ToLowerInvariant() switch
                    {
                        "image/jpeg" => ".jpg",
                        "image/png" => ".png",
                        "image/webp" => ".webp",
                        _ => throw new InvalidOperationException("Format de photo non autorisé.")
                    };
                    var fileName = $"{Guid.NewGuid():N}{extension}";
                    var fullPath = Path.Combine(uploadFolder, fileName);

                    await using (var stream = File.Create(fullPath))
                    await using (var input = photo.OpenReadStream(MaxPhotoBytes))
                        await input.CopyToAsync(stream);

                    db.ShowroomProductImages.Add(new ShowroomProductImage
                    {
                        ProductId = product.Id,
                        ImagePath = $"/uploads/showroom/{fileName}",
                        AltTextFr = product.NameFr,
                        IsPrimary = !hasPrimaryImage,
                        SortOrder = nextSortOrder++,
                        CreatedAt = DateTime.UtcNow
                    });

                    hasPrimaryImage = true;
                }

                await db.SaveChangesAsync();
            }

            selectedPhotos.Clear();
            selectedFileNames.Clear();
            await LoadAsync();
            CancelEdit();
            SetMessage("Fiche showroom enregistrée.", false);
        }
        catch (Exception ex)
        {
            SetMessage($"Enregistrement impossible : {ex.GetBaseException().Message}", true);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteProductAsync(int id)
    {
        var product = products.FirstOrDefault(p => p.Id == id);
        if (product is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.ShowroomProducts.FirstAsync(p => p.Id == id);
        entity.IsDeleted = true;
        entity.IsPublished = false;
        entity.UpdatedAt = DateTime.UtcNow;
        await db.SaveChangesAsync();
        await LoadAsync();
        SetMessage($"La fiche « {product.NameFr} » a été supprimée du catalogue.", false);
    }

    private static bool IsAllowedImage(string contentType) => contentType is "image/jpeg" or "image/png" or "image/webp";
    private static string? Clean(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private async Task<string> MakeUniqueSlugAsync(AppDbContext db, string name, int? currentId)
    {
        var stem = new string(name.Trim().ToLowerInvariant().Normalize(System.Text.NormalizationForm.FormD)
            .Where(c => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) != System.Globalization.UnicodeCategory.NonSpacingMark)
            .Select(c => char.IsLetterOrDigit(c) ? c : '-').ToArray());
        while (stem.Contains("--")) stem = stem.Replace("--", "-");
        stem = stem.Trim('-');
        if (string.IsNullOrWhiteSpace(stem)) stem = "produit";
        var candidate = stem;
        var suffix = 2;
        while (await db.ShowroomProducts.IgnoreQueryFilters().AnyAsync(p => p.Slug == candidate && p.Id != currentId))
            candidate = $"{stem}-{suffix++}";
        return candidate;
    }

    private async Task<string> MakeUniqueEntitySlugAsync(AppDbContext db, string name, string fallback)
    {
        var stem = CreateSlug(name, fallback);
        var candidate = stem;
        var suffix = 2;
        while (await db.ShowroomBrands.IgnoreQueryFilters().AnyAsync(b => b.Slug == candidate))
            candidate = $"{stem}-{suffix++}";
        return candidate;
    }

    private async Task<string> MakeUniqueRangeSlugAsync(AppDbContext db, string name, int brandId)
    {
        var stem = CreateSlug(name, "gamme");
        var candidate = stem;
        var suffix = 2;
        while (await db.ShowroomRanges.IgnoreQueryFilters().AnyAsync(r => r.BrandId == brandId && r.Slug == candidate))
            candidate = $"{stem}-{suffix++}";
        return candidate;
    }

    private static string CreateSlug(string value, string fallback)
    {
        var slug = new string(value.Trim().ToLowerInvariant().Normalize(System.Text.NormalizationForm.FormD)
            .Where(c => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) != System.Globalization.UnicodeCategory.NonSpacingMark)
            .Select(c => char.IsLetterOrDigit(c) ? c : '-').ToArray());
        while (slug.Contains("--")) slug = slug.Replace("--", "-");
        slug = slug.Trim('-');
        return string.IsNullOrWhiteSpace(slug) ? fallback : slug;
    }

    private static string NormalizeLookupValue(string value) => new(value.Trim().ToLowerInvariant()
        .Normalize(System.Text.NormalizationForm.FormD)
        .Where(c => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) != System.Globalization.UnicodeCategory.NonSpacingMark)
        .ToArray());

    private void SetMessage(string text, bool error)
    {
        message = text;
        isError = error;
    }

