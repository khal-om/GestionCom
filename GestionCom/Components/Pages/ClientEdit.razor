@page "/clients/{ClientId:int}/edit"
@using System.Security.Claims
@using GestionCom.DTOs.Client
@using GestionCom.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms

@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

<PageTitle>Modifier client</PageTitle>

<h1>Modifier le client</h1>

<div class="client-create-page">
    <a class="client-create-back" href="@($"/clients/{ClientId}")">← Retour au détail</a>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="client-create-message client-create-message-error">@errorMessage</div>
    }

    <EditForm Model="model" OnValidSubmit="SubmitAsync" FormName="client-edit" class="client-create-form">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <section class="client-create-panel">
            <h2>Informations principales</h2>

            <div class="client-create-grid">
                <div>
                    <label for="name">Nom *</label>
                    <InputText id="name" @bind-Value="model.Name" />
                </div>

                <div>
                    <label for="profession">Profession</label>
                    <InputText id="profession" @bind-Value="model.Profession" />
                </div>

                <div>
                    <label for="matricule">Matricule fiscale</label>
                    <InputText id="matricule" @bind-Value="model.MatriculeFiscale" />
                </div>
            </div>
        </section>

        <section class="client-create-panel">
            <h2>Coordonnées</h2>

            <div class="client-create-grid">
                <div>
                    <label for="telephone">Téléphone</label>
                    <InputText id="telephone" @bind-Value="model.Telephone" />
                </div>

                <div>
                    <label for="portable">Portable</label>
                    <InputText id="portable" @bind-Value="model.Portable" />
                </div>

                <div>
                    <label for="fax">Fax</label>
                    <InputText id="fax" @bind-Value="model.Fax" />
                </div>

                <div class="client-create-grid-full">
                    <label for="email">Email</label>
                    <InputText id="email" @bind-Value="model.Email" />
                </div>
            </div>
        </section>

        <section class="client-create-panel">
            <h2>Adresse</h2>

            <div class="client-create-grid">
                <div class="client-create-grid-full">
                    <label for="adresse">Adresse</label>
                    <InputTextArea id="adresse" @bind-Value="model.Adresse" />
                </div>

                <div>
                    <label for="codepostal">Code postal</label>
                    <InputText id="codepostal" @bind-Value="model.CodePostal" />
                </div>

                <div>
                    <label for="ville">Ville</label>
                    <InputText id="ville" @bind-Value="model.Ville" />
                </div>

                <div>
                    <label for="pays">Pays</label>
                    <InputText id="pays" @bind-Value="model.Pays" />
                </div>
            </div>
        </section>

        <section class="client-create-panel">
            <h2>Coordonnées bancaires</h2>

            <div class="client-create-grid">
                <div>
                    <label for="banque">Banque</label>
                    <InputText id="banque" @bind-Value="model.Banque" />
                </div>

                <div>
                    <label for="rib">RIB</label>
                    <InputText id="rib" @bind-Value="model.RIB" />
                </div>
            </div>
        </section>

        <section class="client-create-panel">
            <h2>Note</h2>

            <div class="client-create-grid">
                <div class="client-create-grid-full">
                    <label for="note">Note</label>
                    <InputTextArea id="note" @bind-Value="model.Note" />
                </div>
            </div>
        </section>

        <div class="client-create-actions">
            <button type="submit" disabled="@isSubmitting">
                @(isSubmitting ? "Enregistrement..." : "Enregistrer les modifications")
            </button>
        </div>
    </EditForm>
</div>

@inject ClientQueryService ClientQueryService
@inject ClientService ClientService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

@code {
    [Parameter]
    public int ClientId { get; set; }

    private CreateClientDto model = new();
    private bool isSubmitting;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        await LoadClientAsync();
    }

    private async Task LoadClientAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var client = await ClientQueryService.GetClientDetailAsync(ClientId);

            model = new CreateClientDto
            {
                Name = client.Name,
                Profession = client.Profession,
                MatriculeFiscale = client.MatriculeFiscale,
                Email = client.Email,
                Telephone = client.Telephone,
                Portable = client.Portable,
                Fax = client.Fax,
                Adresse = client.Adresse,
                CodePostal = client.CodePostal,
                Ville = client.Ville,
                Pays = client.Pays,
                Banque = client.Banque,
                RIB = client.RIB,
                Note = client.Note
            };
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SubmitAsync()
    {
        errorMessage = null;
        isSubmitting = true;

        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userIdValue = authenticationState.User.FindFirstValue(ClaimTypes.NameIdentifier);

            if (!int.TryParse(userIdValue, out var userId))
            {
                throw new InvalidOperationException("Utilisateur introuvable.");
            }

            await ClientService.UpdateClientAsync(ClientId, model, userId, authenticationState.User.IsInRole("Admin"));
            Navigation.NavigateTo($"/clients/{ClientId}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
