@page "/vitrine"
@using System.Globalization
@using GestionCom.Data
@using GestionCom.Features.Showroom.Entities
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject Microsoft.JSInterop.IJSRuntime JS
@using Microsoft.AspNetCore.Components
@layout GestionCom.Components.Layout.BlankLayout
@attribute [AllowAnonymous]
@rendermode InteractiveServer

<PageTitle>FedNad — Soins capillaires professionnels</PageTitle>
<HeadContent>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&display=swap" rel="stylesheet" />
</HeadContent>

<div class="fn-store fn-sephora">
    <div class="fn-announcement">
        <span>VOTRE UNIVERS DE SOINS CAPILLAIRES PROFESSIONNELS</span>
        <span>KEMON <b>×</b> ACTYVA</span>
    </div>

    <header class="fn-header">
        <a class="fn-wordmark" href="/vitrine" aria-label="FedNad, accueil">
            <span class="fn-wordmark-icon">F</span>
            <span class="fn-wordmark-text">fednad<small>BEAUTÉ CAPILLAIRE</small></span>
        </a>
        <nav class="fn-nav" aria-label="Navigation principale">
            <a href="#selection">Tous les soins</a>
            <a href="#selection">Shampoings</a>
            <a href="#selection">Soins & masques</a>
            <a href="#maisons">Nos marques</a>
        </nav>
        <a class="fn-cart-link" href="#panier" aria-label="Voir le panier, @CartCount article(s)">
            <span>Mon panier</span><b>@CartCount</b>
        </a>
    </header>

    @if (!string.IsNullOrWhiteSpace(cartToastProduct))
    {
        <div class="fn-cart-toast" role="status" aria-live="polite">
            <span class="fn-cart-toast-mark">✓</span>
            <span class="fn-cart-toast-copy">
                <strong>Ajouté au panier</strong>
                <span>@cartToastProduct</span>
            </span>
            <a href="#panier">Voir le panier</a>
            <button type="button" class="fn-cart-toast-close" aria-label="Fermer la confirmation" @onclick="DismissCartToast">×</button>
        </div>
    }

    <main>
        @if (selectedProduct is not null)
        {
            <div class="fn-breadcrumb">
                <button type="button" class="fn-back-to-selection" @onclick="CloseProduct">← Retour à la sélection</button>
                <span>/</span><a href="#selection">Cheveux</a><span>/</span>
                <span>@(selectedProduct.CategoryFr ?? "Soins professionnels")</span>
                <span>/</span><strong>@selectedProduct.NameFr</strong>
            </div>
        }

        @if (isLoading)
        {
            <div class="fn-state"><span class="fn-loader"></span><p>Préparation de la sélection…</p></div>
        }
        else if (selectedProduct is not null)
        {
            var galleryImages = SelectedProductImages;
            var activeImage = ActiveProductImage;
            <section class="fn-product-detail" aria-label="Fiche produit">
                <div class="fn-product-gallery">
                    <div class="fn-gallery-thumbnails" aria-label="Autres photos du produit">
                        @for (var i = 0; i < galleryImages.Count; i++)
                        {
                            var imageIndex = i;
                            var image = galleryImages[imageIndex];
                            <button type="button"
                                    class="fn-gallery-thumb @(selectedImageIndex == imageIndex ? "is-active" : "")"
                                    aria-label="Afficher la photo @(imageIndex + 1)"
                                    aria-pressed="@(selectedImageIndex == imageIndex)"
                                    @onclick="() => SelectProductImage(imageIndex)">
                                <img src="@image.ImagePath" alt="@(image.AltTextFr ?? selectedProduct.NameFr)" />
                            </button>
                        }
                    </div>
                    <div class="fn-gallery-main">
                        @if (activeImage is not null)
                        {
                            <img src="@activeImage.ImagePath" alt="@(activeImage.AltTextFr ?? selectedProduct.NameFr)" />
                        }
                        else
                        {
                            <div class="fn-product-placeholder">
                                <span>@selectedProduct.Brand.NameFr</span>
                                <strong>@selectedProduct.NameFr</strong>
                            </div>
                        }
                        @if (selectedProduct.IsNew)
                        {
                            <span class="fn-product-badge">NOUVEAU</span>
                        }
                        @if (galleryImages.Count > 1)
                        {
                            <div class="fn-gallery-counter">@(selectedImageIndex + 1) / @galleryImages.Count</div>
                        }
                    </div>
                </div>

                <div class="fn-product-panel">
                    <div class="fn-product-eyebrow">
                        <span>@selectedProduct.Brand.NameFr</span>
                        @if (selectedProduct.Range is not null)
                        {
                            <span class="fn-eyebrow-divider">·</span><span>@selectedProduct.Range.NameFr</span>
                        }
                    </div>
                    <h1>@selectedProduct.NameFr</h1>
                    @if (!string.IsNullOrWhiteSpace(selectedProduct.ShortDescriptionFr))
                    {
                        <p class="fn-product-short-description">@selectedProduct.ShortDescriptionFr</p>
                    }
                    <div class="fn-product-price-row">
                        <strong class="fn-product-price">@FormatPrice(selectedProduct.PriceTnd) <small>TND</small></strong>
                        @if (!string.IsNullOrWhiteSpace(selectedProduct.Size))
                        {
                            <span class="fn-product-size">@selectedProduct.Size</span>
                        }
                    </div>
                    <div class="fn-product-availability @(selectedProduct.IsAvailable ? "is-available" : "is-unavailable")">
                        <span class="fn-availability-dot"></span>
                        <span>@(string.IsNullOrWhiteSpace(selectedProduct.AvailabilityFr) ? (selectedProduct.IsAvailable ? "Disponible" : "Indisponible") : selectedProduct.AvailabilityFr)</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(selectedProduct.DescriptionFr))
                    {
                        <p class="fn-product-description">@selectedProduct.DescriptionFr</p>
                    }
                    <button type="button"
                            class="fn-detail-add-button"
                            disabled="@(!selectedProduct.IsAvailable)"
                            @onclick="() => AddToCart(selectedProduct)">
                        <span>Ajouter au panier</span><b>＋</b>
                    </button>
                    <div class="fn-product-service-note">
                        <span class="fn-service-symbol">i</span>
                        <span>Un doute sur le soin adapté à vos cheveux ? Découvrez les informations et conseils d'utilisation ci-dessous.</span>
                    </div>
                    <div class="fn-product-meta">
                        <div><span>MARQUE</span><strong>@selectedProduct.Brand.NameFr</strong></div>
                        @if (!string.IsNullOrWhiteSpace(selectedProduct.CategoryFr))
                        {
                            <div><span>CATÉGORIE</span><strong>@selectedProduct.CategoryFr</strong></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(selectedProduct.HairNeedFr))
                        {
                            <div><span>BESOIN</span><strong>@selectedProduct.HairNeedFr</strong></div>
                        }
                    </div>
                </div>
            </section>

            <section class="fn-product-information" aria-label="Informations sur le produit">
                <div class="fn-information-heading">
                    <span>EN SAVOIR PLUS</span>
                    <h2>Tout savoir sur ce soin</h2>
                </div>
                @if (!string.IsNullOrWhiteSpace(selectedProduct.DescriptionFr))
                {
                    <details class="fn-info-accordion" open>
                        <summary>Description</summary>
                        <div class="fn-accordion-content">@selectedProduct.DescriptionFr</div>
                    </details>
                }
                @if (!string.IsNullOrWhiteSpace(selectedProduct.HairNeedFr) || !string.IsNullOrWhiteSpace(selectedProduct.HairTypeFr))
                {
                    <details class="fn-info-accordion">
                        <summary>Pour quels cheveux ?</summary>
                        <div class="fn-accordion-content">
                            @if (!string.IsNullOrWhiteSpace(selectedProduct.HairNeedFr))
                            {
                                <p><strong>Besoin capillaire :</strong> @selectedProduct.HairNeedFr</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(selectedProduct.HairTypeFr))
                            {
                                <p><strong>Type de cheveux :</strong> @selectedProduct.HairTypeFr</p>
                            }
                        </div>
                    </details>
                }
                @if (!string.IsNullOrWhiteSpace(selectedProduct.HowToUseFr))
                {
                    <details class="fn-info-accordion">
                        <summary>Conseils d'utilisation</summary>
                        <div class="fn-accordion-content">@selectedProduct.HowToUseFr</div>
                    </details>
                }
                @if (!string.IsNullOrWhiteSpace(selectedProduct.IngredientsFr))
                {
                    <details class="fn-info-accordion">
                        <summary>Ingrédients</summary>
                        <div class="fn-accordion-content">@selectedProduct.IngredientsFr</div>
                    </details>
                }
                @if (string.IsNullOrWhiteSpace(selectedProduct.DescriptionFr)
                    && string.IsNullOrWhiteSpace(selectedProduct.HairNeedFr)
                    && string.IsNullOrWhiteSpace(selectedProduct.HairTypeFr)
                    && string.IsNullOrWhiteSpace(selectedProduct.HowToUseFr)
                    && string.IsNullOrWhiteSpace(selectedProduct.IngredientsFr))
                {
                    <p class="fn-no-information">Les informations détaillées de ce produit seront bientôt disponibles.</p>
                }
            </section>
        }
        else if (products.Count > 0)
        {
            <section class="fn-home-hero" aria-label="Bienvenue chez FedNad">
                <div class="fn-home-hero-copy">
                    <span class="fn-home-eyebrow"><i></i> BEAUTÉ CAPILLAIRE PROFESSIONNELLE</span>
                    <h1>Vos cheveux.<br /><em>Votre moment.</em></h1>
                    <p>Découvrez les rituels de soin Kemon et Actyva : des essentiels professionnels pour révéler la beauté de vos cheveux, au quotidien.</p>
                    <div class="fn-home-hero-actions">
                        <a href="#selection" class="fn-home-primary">Explorer la sélection <span>→</span></a>
                        <a href="#maisons" class="fn-home-secondary">Découvrir nos marques</a>
                    </div>
                    <div class="fn-home-hero-note"><span>✦</span> L'EXPERTISE DES SOINS PROFESSIONNELS, CHEZ VOUS</div>
                </div>
                <div class="fn-home-hero-visual">
                    <div class="fn-home-hero-orbit fn-home-hero-orbit-one"></div>
                    <div class="fn-home-hero-orbit fn-home-hero-orbit-two"></div>
                    <div class="fn-home-hero-stamp">BEAUTÉ<br /><b>EN SOI</b><span>✦</span></div>
                    <div class="fn-home-product-grid">
                        @foreach (var heroProduct in products.Take(3))
                        {
                            var heroImage = heroProduct.Images.OrderByDescending(x => x.IsPrimary).ThenBy(x => x.SortOrder).FirstOrDefault();
                            <button type="button" class="fn-home-product-tile" @onclick="() => OpenProduct(heroProduct)" aria-label="Découvrir @heroProduct.NameFr">
                                <span class="fn-home-product-photo">
                                    @if (heroImage is not null && !string.IsNullOrWhiteSpace(heroImage.ImagePath))
                                    {
                                        <img src="@heroImage.ImagePath" alt="@heroProduct.NameFr" />
                                    }
                                    else
                                    {
                                        <span class="fn-home-product-fallback">@heroProduct.Brand.NameFr</span>
                                    }
                                </span>
                                <span class="fn-home-product-caption"><b>@heroProduct.Brand.NameFr</b><span>@heroProduct.NameFr</span></span>
                            </button>
                        }
                    </div>
                </div>
            </section>
            <section class="fn-home-brand-ribbon" aria-label="Nos marques">
                <span>LE MEILLEUR DU SOIN PROFESSIONNEL</span>
                <strong>KEMON</strong><i>✦</i><strong>ACTYVA</strong>
                <span>LA BEAUTÉ DES CHEVEUX, AUTREMENT</span>
            </section>
        }
        else
        {
            <div class="fn-empty-state">
                <h1>Les soins professionnels, simplement.</h1>
                <p>La sélection de produits sera bientôt disponible.</p>
            </div>
        }

        <section class="fn-catalog" id="selection">
            <div class="fn-section-heading">
                <div>
                    <span class="fn-section-kicker">LA SÉLECTION FEDNAD <i></i> @products.Count PRODUITS</span>
                    <h2>À découvrir<br /><span>dans notre sélection.</span></h2>
                </div>
                <p>Retrouvez les soins professionnels Kemon et Actyva. Faites défiler la sélection et choisissez le produit qui correspond à vos cheveux.</p>
            </div>

            <div class="fn-catalog-toolbar">
                <div class="fn-filters" aria-label="Filtrer par marque">
                    <button class="@(selectedBrandSlug is null ? "is-active" : "")" aria-pressed="@(selectedBrandSlug is null)" @onclick="() => SelectBrand(null)">Tout voir</button>
                    @foreach (var brand in brands)
                    {
                        <button class="@(selectedBrandSlug == brand.Slug ? "is-active" : "")" aria-pressed="@(selectedBrandSlug == brand.Slug)" @onclick="() => SelectBrand(brand.Slug)">@brand.NameFr</button>
                    }
                </div>
                <span class="fn-result-count">@FilteredProducts.Count() PRODUIT(S)</span>
            </div>

            @if (!FilteredProducts.Any())
            {
                <div class="fn-state fn-empty"><p>Aucun produit dans cette sélection pour le moment.</p></div>
            }
            else
            {
                <div class="fn-carousel-heading">
                    <div><span class="fn-carousel-kicker">À PARCOURIR</span><p>Une sélection qui défile à votre rythme.</p></div>
                    <div class="fn-carousel-controls">
                        <button type="button" class="fn-carousel-arrow" aria-label="Produits précédents" @onclick="() => ScrollProducts(-1)">←</button>
                        <button type="button" class="fn-carousel-arrow" aria-label="Produits suivants" @onclick="() => ScrollProducts(1)">→</button>
                        <button type="button" class="fn-carousel-toggle" aria-pressed="@isAutoplayPaused" @onclick="ToggleProductAutoplay">
                            @(isAutoplayPaused ? "▶ Reprendre" : "Ⅱ Pause")
                        </button>
                    </div>
                </div>
                <div class="fn-product-track" @ref="productTrack" tabindex="0" aria-label="Défilement horizontal automatique des produits. Survolez ou utilisez les commandes pour le contrôler.">
                    @foreach (var product in FilteredProducts)
                    {
                        var image = product.Images.OrderByDescending(x => x.IsPrimary).ThenBy(x => x.SortOrder).FirstOrDefault();
                        <article class="fn-product-card" @key="product.Id">
                            <button type="button" class="fn-product-image" @onclick="() => OpenProduct(product)" aria-label="Découvrir @product.NameFr">
                                @if (image is not null && !string.IsNullOrWhiteSpace(image.ImagePath))
                                {
                                    <img src="@image.ImagePath" alt="@(image.AltTextFr ?? product.NameFr)" loading="lazy" />
                                }
                                else
                                {
                                    <span class="fn-product-placeholder"><b>@product.Brand.NameFr</b><strong>@product.NameFr</strong></span>
                                }
                                @if (product.IsNew)
                                {
                                    <span class="fn-new-label">NOUVEAU</span>
                                }
                                <span class="fn-quick-view">Voir le produit ↗</span>
                            </button>
                            <div class="fn-product-info">
                                <div class="fn-product-brandline"><span>@product.Brand.NameFr</span>@if (!string.IsNullOrWhiteSpace(product.Size)) { <small>@product.Size</small> }</div>
                                <button type="button" class="fn-product-name" @onclick="() => OpenProduct(product)">@product.NameFr</button>
                                <div class="fn-product-bottom">
                                    <strong>@FormatPrice(product.PriceTnd) <small>TND</small></strong>
                                    <button type="button" class="fn-add-button" title="Ajouter au panier" aria-label="Ajouter @product.NameFr au panier" disabled="@(!product.IsAvailable)" @onclick="() => AddToCart(product)">+</button>
                                </div>
                            </div>
                        </article>
                    }
                </div>
                <div class="fn-carousel-footnote"><span>↔</span> DÉFILEMENT AUTOMATIQUE · SURVOLEZ POUR METTRE EN PAUSE</div>
            }
        </section>

        <section class="fn-brand-strip" id="maisons">
            <div><span>LES MARQUES</span><h2>Deux maisons.<br />Une même exigence.</h2></div>
            <div class="fn-brand-wordmarks"><strong>KEMON</strong><span>×</span><strong>ACTYVA</strong></div>
            <p>Des soins professionnels italiens, sélectionnés par FedNad.</p>
        </section>

        <section class="fn-cart-section" id="panier">
            <div class="fn-cart-title">
                <div><span class="fn-section-kicker">VOTRE SÉLECTION</span><h2>Votre panier</h2></div>
                <span class="fn-cart-total-count">@CartCount ARTICLE(S)</span>
            </div>
            <div class="fn-cart-layout">
                <div class="fn-cart-items">
                    @if (!cart.Any())
                    {
                        <div class="fn-cart-empty">
                            <span class="fn-empty-icon">＋</span>
                            <div><strong>Votre panier est encore vide.</strong><p>Ajoutez vos soins favoris pour retrouver votre sélection ici.</p></div>
                            <a href="#selection">Voir les produits ↗</a>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in cart)
                        {
                            var product = FindProduct(item.Key);
                            if (product is not null)
                            {
                                var image = product.Images.OrderByDescending(x => x.IsPrimary).ThenBy(x => x.SortOrder).FirstOrDefault();
                                <div class="fn-cart-item" @key="item.Key">
                                    <div class="fn-cart-image">
                                        @if (image is not null) { <img src="@image.ImagePath" alt="" /> }
                                        else { <span>@product.Brand.NameFr</span> }
                                    </div>
                                    <div class="fn-cart-product">
                                        <small>@product.Brand.NameFr</small><strong>@product.NameFr</strong>
                                        <button type="button" @onclick="() => RemoveFromCart(product.Id)">Retirer</button>
                                    </div>
                                    <div class="fn-quantity">
                                        <button type="button" aria-label="Diminuer la quantité" @onclick="() => ChangeQuantity(product.Id, -1)">−</button>
                                        <span>@item.Value</span>
                                        <button type="button" aria-label="Augmenter la quantité" @onclick="() => ChangeQuantity(product.Id, 1)">+</button>
                                    </div>
                                    <strong class="fn-line-total">@FormatPrice(product.PriceTnd * item.Value) <small>TND</small></strong>
                                </div>
                            }
                        }
                    }
                </div>
                <aside class="fn-order-summary">
                    <span class="fn-section-kicker">RÉCAPITULATIF</span>
                    <div class="fn-summary-row"><span>Nombre d'articles</span><strong>@CartCount</strong></div>
                    <div class="fn-summary-row"><span>Sous-total</span><strong>@FormatPrice(CartTotal) TND</strong></div>
                    <div class="fn-summary-total"><span>TOTAL ESTIMATIF</span><strong>@FormatPrice(CartTotal) <small>TND</small></strong></div>
                    <button type="button" class="fn-checkout-button" disabled="@(!cart.Any())" @onclick="ShowCheckoutPreview">Continuer <span>→</span></button>
                    <p>Prototype de démonstration. Aucune commande ni aucun paiement ne seront effectués.</p>
                </aside>
            </div>
        </section>
    </main>

    <footer class="fn-footer">
        <a class="fn-wordmark fn-footer-logo" href="/vitrine"><span class="fn-wordmark-icon">F</span><span class="fn-wordmark-text">fednad<small>BEAUTÉ CAPILLAIRE</small></span></a>
        <p>Des soins professionnels.<br /><strong>Un choix qui vous ressemble.</strong></p>
        <div class="fn-footer-links"><a href="#selection">Les produits</a><a href="#maisons">Les marques</a><a href="#panier">Mon panier</a></div>
        <small>© @DateTime.Now.Year FEDNAD · KEMON · ACTYVA</small>
    </footer>
</div>

@if (showCheckoutPreview)
{
    <div class="fn-modal-backdrop" @onclick="() => showCheckoutPreview = false">
        <section class="fn-checkout-modal" role="dialog" aria-modal="true" aria-label="Aperçu de commande" @onclick:stopPropagation="true">
            <button type="button" class="fn-modal-close" aria-label="Fermer" @onclick="() => showCheckoutPreview = false">×</button>
            <span class="fn-section-kicker">LA PROCHAINE ÉTAPE</span>
            <h2>Votre sélection est prête.</h2>
            <p>La prochaine étape permettra de transmettre votre sélection à l'équipe FedNad.</p>
            <div class="fn-checkout-total"><span>@CartCount article(s)</span><strong>@FormatPrice(CartTotal) TND</strong></div>
            <div class="fn-preview-fields">
                <label>Nom et prénom<input disabled placeholder="Votre nom" /></label>
                <label>Téléphone<input disabled placeholder="+216 ..." /></label>
                <label>Adresse / Ville<input disabled placeholder="Votre adresse" /></label>
            </div>
            <div class="fn-preview-note">APERÇU UNIQUEMENT — LA COMMANDE EN LIGNE SERA ACTIVÉE PLUS TARD.</div>
        </section>
    </div>
}

@code {
    private List<ShowroomBrand> brands = new();
    private List<ShowroomProduct> products = new();
    private readonly Dictionary<int, int> cart = new();

    private bool isLoading = true;
    private bool showCheckoutPreview;
    private string? selectedBrandSlug;
    private ShowroomProduct? selectedProduct;
    private ElementReference productTrack;
    private bool isAutoplayPaused;
    private string? cartToastProduct;
    private int selectedImageIndex;

    private IEnumerable<ShowroomProduct> FilteredProducts =>
        products.Where(product =>
            selectedBrandSlug is null || product.Brand.Slug == selectedBrandSlug);

    private List<ShowroomProductImage> SelectedProductImages =>
        selectedProduct?.Images
            .OrderByDescending(image => image.IsPrimary)
            .ThenBy(image => image.SortOrder)
            .ToList() ?? new();

    private ShowroomProductImage? ActiveProductImage =>
        SelectedProductImages.ElementAtOrDefault(selectedImageIndex);

    private int CartCount => cart.Values.Sum();

    private decimal CartTotal => cart.Sum(item =>
    {
        var product = FindProduct(item.Key);
        return product is null ? 0m : product.PriceTnd * item.Value;
    });

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        brands = await db.ShowroomBrands
            .AsNoTracking()
            .Where(brand => brand.IsPublished)
            .OrderBy(brand => brand.SortOrder)
            .ThenBy(brand => brand.NameFr)
            .ToListAsync();

        products = await db.ShowroomProducts
            .AsNoTracking()
            .Where(product => product.IsPublished && product.Brand.IsPublished)
            .Include(product => product.Brand)
            .Include(product => product.Range)
            .Include(product => product.Images)
            .OrderBy(product => product.SortOrder)
            .ThenBy(product => product.NameFr)
            .ToListAsync();

        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!isLoading && products.Count > 0)
        {
            var isRunning = await JS.InvokeAsync<bool>(
                "fednadShowroom.initProductAutoplay", productTrack, isAutoplayPaused);
            isAutoplayPaused = !isRunning;
        }
    }

    private async Task ScrollProducts(int direction)
    {
        await JS.InvokeVoidAsync("fednadShowroom.scrollProducts", productTrack, direction);
    }

    private async Task ToggleProductAutoplay()
    {
        isAutoplayPaused = !isAutoplayPaused;
        await JS.InvokeVoidAsync("fednadShowroom.setAutoplayPaused", isAutoplayPaused);
    }

    private void SelectBrand(string? slug)
    {
        selectedBrandSlug = slug;
    }

    private void SelectProductImage(int index)
    {
        selectedImageIndex = index;
    }

    private void AddToCart(ShowroomProduct product)
    {
        if (!product.IsAvailable)
            return;

        cart[product.Id] = cart.TryGetValue(product.Id, out var quantity)
            ? quantity + 1
            : 1;

        cartToastProduct = product.NameFr;
    }

    private void DismissCartToast()
    {
        cartToastProduct = null;
    }

    private void ChangeQuantity(int productId, int change)
    {
        if (!cart.TryGetValue(productId, out var quantity))
            return;

        var next = quantity + change;

        if (next <= 0)
            cart.Remove(productId);
        else
            cart[productId] = next;
    }

    private void RemoveFromCart(int productId)
    {
        cart.Remove(productId);
    }

    private ShowroomProduct? FindProduct(int id) =>
        products.FirstOrDefault(product => product.Id == id);

    private void OpenProduct(ShowroomProduct product)
    {
        selectedProduct = product;
        selectedImageIndex = 0;
    }

    private void CloseProduct()
    {
        selectedProduct = null;
        selectedImageIndex = 0;
    }

    private void ShowCheckoutPreview()
    {
        if (cart.Any())
            showCheckoutPreview = true;
    }

    private static string FormatPrice(decimal price) =>
        price.ToString("N2", CultureInfo.GetCultureInfo("fr-TN"));
}