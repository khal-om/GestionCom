@page "/vitrine"
@using System.Globalization
@using GestionCom.Data
@using GestionCom.Features.Showroom.Entities
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS
@layout GestionCom.Components.Layout.BlankLayout
@attribute [AllowAnonymous]
@rendermode InteractiveServer

<PageTitle>FedNad — La boutique capillaire</PageTitle>

<HeadContent><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap" rel="stylesheet" /></HeadContent>

<div class="fd-shop">
    <div class="fd-topline">
        <span>FEDNAD · BEAUTÉ PROFESSIONNELLE</span>
        <span>LES UNIVERS KEMON & ACTYVA</span>
        <a href="#panier">Mon panier <b>@CartCount</b></a>
    </div>

    <header class="fd-header">
        <a class="fd-logo" href="/vitrine">
            <span>FED<span>N</span>AD</span>
            <small>SOINS CAPILLAIRES</small>
        </a>

        <nav>
            <a href="#boutique">Nos univers</a>
            <a href="#selection">Notre sélection</a>
            <a href="#panier">Mon panier</a>
        </nav>

        <a class="fd-header-cta" href="#selection">Découvrir nos soins <span>↗</span></a>
    </header>

    <main>
        <section class="fd-boutique-hero">
            <img class="fd-hero-photo" src="/images/fednad-boutique.svg"
                 alt="Illustration de la boutique FedNad, avec ses arches lumineuses et son comptoir de soins capillaires"
                 fetchpriority="high" />
            <div class="fd-hero-shade"></div>
            <div class="fd-hero-content">
                <span class="fd-hero-kicker"><i></i> FEDNAD · BEAUTÉ CAPILLAIRE</span>
                <h1>Le beau geste.<br /><em>Le bon rituel.</em></h1>
                <p>Deux maisons expertes, Kemon et Actyva. Une sélection de soins professionnels pensée pour révéler vos cheveux.</p>
                <a href="#selection" class="fd-hero-button">ENTRER DANS LA BOUTIQUE <span>↘</span></a>
            </div>
            <div class="fd-hero-stamp"><span>LE COMPTOIR</span><strong>F.</strong><span>DEPUIS FEDNAD</span></div>
            <div class="fd-hero-bottom"><span>KEMON <b>×</b> ACTYVA</span><span>SOINS PROFESSIONNELS · TUNISIE</span></div>
        </section>

        <section class="fd-intro-strip" id="boutique">
            <span>LE SOIN</span><i>✳</i><span>LA TEXTURE</span><i>✳</i><span>LE GESTE</span><i>✳</i><span>VOTRE RITUEL</span><i>✳</i><span>LE SOIN</span>
        </section>

        <section class="fd-counter-section" id="selection">
            <div class="fd-counter-heading">
                <div>
                    <span class="fd-eyebrow">LE COMPTOIR FEDNAD <i></i> SÉLECTION CURATÉE</span>
                    <h2>Vos essentiels.<br /><em>Vos beaux cheveux.</em></h2>
                </div>
                <p>Parcourez les soins Kemon et Actyva, découvrez les textures et composez votre rituel, un produit à la fois.</p>
            </div>
            <div class="fd-filter-row">
                <button class="@(selectedBrandSlug is null ? "active" : "")" @onclick="() => SelectBrand(null)">TOUT LE COMPTOIR</button>
                @foreach (var brand in brands)
                {
                    <button class="@(selectedBrandSlug == brand.Slug ? "active" : "")" @onclick="() => SelectBrand(brand.Slug)">@brand.NameFr</button>
                }
                <span class="fd-product-count">@FilteredProducts.Count() RÉFÉRENCES</span>
            </div>
            @if (isLoading)
            {
                <div class="fd-empty-state">Le comptoir se prépare…</div>
            }
            else if (!FilteredProducts.Any())
            {
                <div class="fd-empty-state"><span>✳</span><h3>Le comptoir se prépare.</h3><p>Nos soins seront bientôt disponibles.</p></div>
            }
            else
            {
                <div class="fd-conveyor-label"><span><i></i> LE CONVOYEUR FEDNAD</span><span>TOUCHEZ UN PRODUIT POUR LE DÉCOUVRIR</span></div>
                <div class="fd-belt-controls" aria-label="Navigation des produits">
                    <span>PRENEZ LE TEMPS DE DÉCOUVRIR</span>
                    <div>
                        <button type="button" class="fd-belt-arrow" aria-label="Produits précédents" title="Produits précédents" @onclick="() => ScrollProducts(-1)">←</button>
                        <button type="button" class="fd-belt-arrow" aria-label="Produits suivants" title="Produits suivants" @onclick="() => ScrollProducts(1)">→</button>
                    </div>
                </div>
                <div class="fd-belt-shell" @ref="productTrack">
                    <div class="fd-belt-track">
                        @foreach (var product in BeltProducts)
                        {
                            var image = product.Images.OrderByDescending(x => x.IsPrimary).ThenBy(x => x.SortOrder).FirstOrDefault();
                            <article class="fd-belt-product" @key="product.Id">
                                <button type="button" class="fd-product-visual" @onclick="() => OpenProduct(product)" aria-label="Découvrir @product.NameFr">
                                    @if (image is not null && !string.IsNullOrWhiteSpace(image.ImagePath))
                                    {
                                        <img src="@image.ImagePath" alt="@(image.AltTextFr ?? product.NameFr)" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="fd-product-placeholder"><span>@product.Brand.NameFr</span><strong>@product.NameFr</strong></div>
                                    }
                                    @if (product.IsNew) { <span class="fd-new-tag">NOUVEAU</span> }
                                    <span class="fd-view-product">DÉCOUVRIR <b>↗</b></span>
                                </button>
                                <div class="fd-product-plaque">
                                    <span class="fd-product-brand">@product.Brand.NameFr</span>
                                    <h3>@product.NameFr</h3>
                                    @if (!string.IsNullOrWhiteSpace(product.Size)) { <small>@product.Size</small> }
                                    <div class="fd-product-price-row">
                                        <strong>@FormatPrice(product.PriceTnd) <small>TND</small></strong>
                                        <button type="button" title="Ajouter au panier" @onclick="() => AddToCart(product)">+</button>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                </div>
                <div class="fd-belt-caption"><span>GLISSEZ OU UTILISEZ LES FLÈCHES</span><span>Revenez en arrière à tout moment pour retrouver un produit.</span></div>
            }
        </section>

        <section class="fd-atelier">
            <div class="fd-atelier-mark">F.</div>
            <div class="fd-atelier-copy">
                <span class="fd-eyebrow">KEMON × ACTYVA · L'EXPERTISE EN DEUX UNIVERS</span>
                <h2>Un rituel qui<br /><em>vous ressemble.</em></h2>
                <p>Des soins ciblés, des gestes simples et des formules professionnelles : choisissez les essentiels qui accompagnent vos cheveux au quotidien.</p>
                <a href="#selection">TROUVER MES ESSENTIELS <b>↗</b></a>
            </div>
            <div class="fd-atelier-art" aria-hidden="true"><div class="fd-atelier-arch"><span>F</span></div><div class="fd-atelier-orbit"></div><div class="fd-atelier-tag">GOOD<br />HAIR<br /><b>ENERGY</b></div></div>
        </section>

        <section class="fd-cart-section" id="panier">
            <div class="fd-cart-heading">
                <div>
                    <span class="fd-eyebrow">VOTRE SÉLECTION · VOTRE RITUEL</span>
                    <h2>Créez <em>votre rituel.</em></h2>
                </div>
                <span class="fd-cart-counter">@CartCount ARTICLE(S)</span>
            </div>

            <div class="fd-cart-layout">
                <div class="fd-cart-list">
                    <div class="fd-cart-list-head">
                        <span>VOTRE SÉLECTION</span>
                        <span>QUANTITÉ / PRIX</span>
                    </div>

                    @if (!cart.Any())
                    {
                        <div class="fd-cart-empty">
                            <span class="fd-empty-bag">✳</span>
                            <div>
                                <strong>Votre panier attend son premier coup de cœur.</strong>
                                <p>Ajoutez vos produits préférés depuis le comptoir.</p>
                            </div>
                            <a href="#selection">DÉCOUVRIR LES PRODUITS ↗</a>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in cart)
                        {
                            var product = FindProduct(item.Key);
                            if (product is not null)
                            {
                                var image = product.Images
                                    .OrderByDescending(x => x.IsPrimary)
                                    .ThenBy(x => x.SortOrder)
                                    .FirstOrDefault();

                                <div class="fd-cart-item" @key="item.Key">
                                    <div class="fd-cart-thumb">
                                        @if (image is not null)
                                        {
                                            <img src="@image.ImagePath" alt="" />
                                        }
                                        else
                                        {
                                            <span>@product.Brand.NameFr</span>
                                        }
                                    </div>
                                    <div class="fd-cart-product-info">
                                        <span>@product.Brand.NameFr</span>
                                        <strong>@product.NameFr</strong>
                                        <button type="button" @onclick="() => RemoveFromCart(product.Id)">RETIRER</button>
                                    </div>
                                    <div class="fd-quantity-control">
                                        <button type="button" @onclick="() => ChangeQuantity(product.Id, -1)">−</button>
                                        <span>@item.Value</span>
                                        <button type="button" @onclick="() => ChangeQuantity(product.Id, 1)">+</button>
                                    </div>
                                    <strong class="fd-cart-line-total">@FormatPrice(product.PriceTnd * item.Value) <small>TND</small></strong>
                                </div>
                            }
                        }
                    }
                </div>

                <aside class="fd-cart-summary">
                    <span class="fd-eyebrow">VOTRE ESPACE COMMANDE</span>
                    <h3>Votre sélection,<br /><em>votre beauté.</em></h3>
                    <div class="fd-summary-line"><span>Articles</span><strong>@CartCount</strong></div>
                    <div class="fd-summary-line"><span>Sous-total</span><strong>@FormatPrice(CartTotal) TND</strong></div>
                    <div class="fd-summary-total"><span>TOTAL ESTIMATIF</span><strong>@FormatPrice(CartTotal) <small>TND</small></strong></div>
                    <button type="button" class="fd-checkout-button" disabled="@(!cart.Any())"
                            @onclick="ShowCheckoutPreview">
                        POURSUIVRE <span>→</span>
                    </button>
                    <p>Prototype de démonstration. Aucune commande ni aucun paiement ne seront effectués.</p>
                </aside>
            </div>
        </section>
    </main>

    <footer class="fd-footer">
        <div class="fd-footer-brand">
            <a class="fd-logo fd-logo-footer" href="/vitrine">
                <span>FED<span>N</span>AD</span>
                <small>HAIRCARE BOUTIQUE</small>
            </a>
            <p>Le soin professionnel.<br /><em>Une attention personnelle.</em></p>
        </div>
        <div class="fd-footer-links">
            <a href="#boutique">La boutique</a>
            <a href="#selection">Les produits</a>
            <a href="#panier">Mon panier</a>
        </div>
        <div class="fd-footer-bottom">
            <span>© @DateTime.Now.Year FEDNAD · KEMON · ACTYVA</span>
            <span>LA BEAUTÉ PROFESSIONNELLE, AUTREMENT.</span>
        </div>
    </footer>
</div>

@if (selectedProduct is not null)
{
    var detailImage = selectedProduct.Images
        .OrderByDescending(x => x.IsPrimary)
        .ThenBy(x => x.SortOrder)
        .FirstOrDefault();

    <div class="fd-modal-backdrop" @onclick="CloseProduct">
        <section class="fd-product-modal" role="dialog" aria-modal="true"
                 aria-label="Détails du produit" @onclick:stopPropagation="true">
            <button type="button" class="fd-modal-close" @onclick="CloseProduct">×</button>

            <div class="fd-modal-image">
                @if (detailImage is not null)
                {
                    <img src="@detailImage.ImagePath"
                         alt="@(detailImage.AltTextFr ?? selectedProduct.NameFr)" />
                }
                else
                {
                    <div class="fd-product-placeholder">
                        <span>@selectedProduct.Brand.NameFr</span>
                        <strong>@selectedProduct.NameFr</strong>
                    </div>
                }
            </div>

            <div class="fd-modal-info">
                <span class="fd-eyebrow">@selectedProduct.Brand.NameFr
                    @if (selectedProduct.Range is not null)
                    {
                        <text> · @selectedProduct.Range.NameFr</text>
                    }
                </span>
                <h2>@selectedProduct.NameFr</h2>
                @if (!string.IsNullOrWhiteSpace(selectedProduct.Size))
                {
                    <span class="fd-modal-size">@selectedProduct.Size</span>
                }
                <strong class="fd-modal-price">@FormatPrice(selectedProduct.PriceTnd) TND</strong>

                @if (!string.IsNullOrWhiteSpace(selectedProduct.DescriptionFr))
                {
                    <p>@selectedProduct.DescriptionFr</p>
                }
                @if (!string.IsNullOrWhiteSpace(selectedProduct.HairNeedFr))
                {
                    <h4>Besoin capillaire</h4>
                    <p>@selectedProduct.HairNeedFr</p>
                }
                @if (!string.IsNullOrWhiteSpace(selectedProduct.HairTypeFr))
                {
                    <h4>Type de cheveux</h4>
                    <p>@selectedProduct.HairTypeFr</p>
                }
                @if (!string.IsNullOrWhiteSpace(selectedProduct.HowToUseFr))
                {
                    <h4>Conseils d'utilisation</h4>
                    <p>@selectedProduct.HowToUseFr</p>
                }

                <button type="button" class="fd-modal-add" @onclick="() => AddToCart(selectedProduct)">
                    AJOUTER À MON PANIER <span>＋</span>
                </button>
            </div>
        </section>
    </div>
}

@if (showCheckoutPreview)
{
    <div class="fd-modal-backdrop" @onclick="() => showCheckoutPreview = false">
        <section class="fd-checkout-modal" role="dialog" aria-modal="true"
                 aria-label="Aperçu de commande" @onclick:stopPropagation="true">
            <button type="button" class="fd-modal-close" @onclick="() => showCheckoutPreview = false">×</button>
            <span class="fd-eyebrow">LA PROCHAINE ÉTAPE</span>
            <h2>Bientôt <em>à vous.</em></h2>
            <p>La prochaine étape permettra de transmettre votre sélection à l'équipe FedNad.</p>
            <div class="fd-checkout-preview-total">
                <span>Votre sélection · @CartCount article(s)</span>
                <strong>@FormatPrice(CartTotal) TND</strong>
            </div>
            <div class="fd-preview-fields">
                <label>Nom et prénom<input disabled placeholder="Votre nom" /></label>
                <label>Téléphone<input disabled placeholder="+216 ..." /></label>
                <label>Adresse / Ville<input disabled placeholder="Votre adresse" /></label>
            </div>
            <div class="fd-preview-note">APERÇU UNIQUEMENT — LA COMMANDE EN LIGNE SERA ACTIVÉE PLUS TARD.</div>
        </section>
    </div>
}

@code {
    private ElementReference productTrack;

    private async Task ScrollProducts(int direction)
    {
        await JS.InvokeVoidAsync("fednadShowroom.scrollProducts", productTrack, direction);
    }

    private List<ShowroomBrand> brands = new();
    private List<ShowroomProduct> products = new();
    private readonly Dictionary<int, int> cart = new();

    private bool isLoading = true;
    private bool showCheckoutPreview;
    private string? selectedBrandSlug;
    private ShowroomProduct? selectedProduct;

    private IEnumerable<ShowroomProduct> FilteredProducts =>
        products.Where(product =>
            selectedBrandSlug is null || product.Brand.Slug == selectedBrandSlug);

    private List<ShowroomProduct> BeltProducts =>
        FilteredProducts.ToList();

    private int CartCount => cart.Values.Sum();

    private decimal CartTotal => cart.Sum(item =>
    {
        var product = FindProduct(item.Key);
        return product is null ? 0m : product.PriceTnd * item.Value;
    });

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        brands = await db.ShowroomBrands
            .AsNoTracking()
            .Where(brand => brand.IsPublished)
            .OrderBy(brand => brand.SortOrder)
            .ThenBy(brand => brand.NameFr)
            .ToListAsync();

        products = await db.ShowroomProducts
            .AsNoTracking()
            .Where(product => product.IsPublished && product.Brand.IsPublished)
            .Include(product => product.Brand)
            .Include(product => product.Range)
            .Include(product => product.Images)
            .OrderBy(product => product.SortOrder)
            .ThenBy(product => product.NameFr)
            .ToListAsync();

        isLoading = false;
    }

    private void SelectBrand(string? slug)
    {
        selectedBrandSlug = slug;
    }

    private void AddToCart(ShowroomProduct product)
    {
        cart[product.Id] = cart.TryGetValue(product.Id, out var quantity)
            ? quantity + 1
            : 1;

        selectedProduct = null;
    }

    private void ChangeQuantity(int productId, int change)
    {
        if (!cart.TryGetValue(productId, out var quantity))
            return;

        var next = quantity + change;

        if (next <= 0)
            cart.Remove(productId);
        else
            cart[productId] = next;
    }

    private void RemoveFromCart(int productId)
    {
        cart.Remove(productId);
    }

    private ShowroomProduct? FindProduct(int id) =>
        products.FirstOrDefault(product => product.Id == id);

    private void OpenProduct(ShowroomProduct product)
    {
        selectedProduct = product;
    }

    private void CloseProduct()
    {
        selectedProduct = null;
    }

    private void ShowCheckoutPreview()
    {
        if (cart.Any())
            showCheckoutPreview = true;
    }

    private static string FormatPrice(decimal price) =>
        price.ToString("N2", CultureInfo.GetCultureInfo("fr-TN"));
}