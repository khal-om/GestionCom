@rendermode InteractiveServer
@layout EmptyLayout

@page "/login"
@using Microsoft.AspNetCore.Components
@using GestionCom.Components.Layout

<PageTitle>Connexion</PageTitle>

<div class="login-page">
    <div class="login-card">

        <div class="login-logo-panel">
            <img src="branding/logo.jpeg" alt="Logo GestionCom" class="login-logo-image" />
        </div>

        <div class="login-form-panel">
            <div class="login-heading">
                <h1>Connexion</h1>
                <p>Accédez à votre espace de gestion interne.</p>
            </div>

            @if (HasError)
            {
                <div class="login-error">Identifiants invalides. Veuillez réessayer.</div>
            }

            <form method="post" action="@FormAction" class="login-form">
                <div class="login-info">La session reste ouverte sur cet appareil pendant 14 jours.</div>
                <div class="login-field">
                    <label for="username">Nom d'utilisateur</label>
                    <input id="username" name="Username" placeholder="Nom d'utilisateur" autocomplete="username" />
                </div>
                <div class="login-field">
                    <label for="password">Mot de passe</label>
                    <input id="password" type="password" name="Password" placeholder="••••••••" autocomplete="current-password" />
                </div>
                <button type="submit">Se connecter</button>
            </form>
        </div>

    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private bool HasError => string.Equals(Error, "1", StringComparison.Ordinal);

    private string FormAction => string.IsNullOrWhiteSpace(ReturnUrl)
        ? "/api/auth/login"
        : $"/api/auth/login?returnUrl={Uri.EscapeDataString(ReturnUrl)}";
}
