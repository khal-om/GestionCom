@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider

@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Accueil</PageTitle>

<div class="idx-page">

    <div class="idx-header">
        <div class="idx-header-row">
            <div>
                <h1>Accueil</h1>
                <p>Accès rapide aux modules</p>
            </div>
            <div class="idx-identity-card">
                <div class="idx-identity-avatar">@_initials</div>
                <div class="idx-identity-info">
                    <span class="idx-identity-name">@_userName</span>
                    <span class="idx-identity-date">@_today</span>
                </div>
            </div>
        </div>
    </div>

    <div class="idx-block">
        <div class="idx-block-header"><span class="idx-block-label">Gestion commerciale</span></div>
        <div class="idx-grid">

            <a class="idx-tile" href="/clients">
                <div class="idx-tile-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                </div>
                <div class="idx-tile-body"><strong>Clients</strong><p>Comptes et historique des paiements.</p></div>
            </a>

            <a class="idx-tile" href="/ventes">
                <div class="idx-tile-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <polyline points="14 2 14 8 20 8"/>
                        <line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
                    </svg>
                </div>
                <div class="idx-tile-body"><strong>Ventes</strong><p>Suivi et livraison des commandes.</p></div>
            </a>

            <a class="idx-tile" href="/achats">
                <div class="idx-tile-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                    </svg>
                </div>
                <div class="idx-tile-body"><strong>Achats</strong><p>Fournisseurs et approvisionnements.</p></div>
            </a>

        </div>
    </div>

    <div class="idx-block">
        <div class="idx-block-header"><span class="idx-block-label">Inventaire &amp; finances</span></div>
        <div class="idx-grid">

            <a class="idx-tile" href="/produits">
                <div class="idx-tile-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>
                    </svg>
                </div>
                <div class="idx-tile-body"><strong>Stock</strong><p>Produits et disponibilites.</p></div>
            </a>

            <a class="idx-tile" href="/depenses">
                <div class="idx-tile-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="1" x2="12" y2="23"/>
                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                    </svg>
                </div>
                <div class="idx-tile-body"><strong>Depenses</strong><p>Charges et depenses internes.</p></div>
            </a>

            <a class="idx-tile" href="/calendrier">
                <div class="idx-tile-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                        <line x1="16" y1="2" x2="16" y2="6" />
                        <line x1="8" y1="2" x2="8" y2="6" />
                        <line x1="3" y1="10" x2="21" y2="10" />
                    </svg>
                </div>
                <div class="idx-tile-body"><strong>Calendrier</strong><p>Echeances et rappels.</p></div>
            </a>

            

        </div>
    </div>

    <div class="idx-block">
        <div class="idx-block-header"><span class="idx-block-label">Administration</span></div>
        <div class="idx-grid">

            <a class="idx-tile" href="/rapport-journalier">
                <div class="idx-tile-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                        <path d="M3 10h18M8 2v4M16 2v4" />
                        <path d="M4 14h16M4 18h16" />
                    </svg>
                </div>
                <div class="idx-tile-body"><strong>Rapport journalier</strong><p>Voir ventes et règlements par jour.</p></div>
            </a>

            <a class="idx-tile" href="/dashboard">
                <div class="idx-tile-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="3" width="20" height="14" rx="2" />
                        <path d="M8 21h8m-4-4v4" />
                    </svg>
                </div>
                <div class="idx-tile-body"><strong>Dashboard</strong><p>Indicateurs cles et vue d ensemble.</p></div>
            </a>

            

            <a class="idx-tile" href="/profil">
                <div class="idx-tile-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                    </svg>
                </div>
                <div class="idx-tile-body"><strong>Profil</strong><p>Preferences et acces.</p></div>
            </a>

            <a class="idx-tile" href="/parametres">
                <div class="idx-tile-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="3"/>
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                    </svg>
                </div>
                <div class="idx-tile-body"><strong>Parametres</strong><p>Configuration et options.</p></div>
            </a>

        </div>
    </div>

</div>

@code {
    private string _userName = "";
    private string _initials = "";
    private string _today = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _userName = user.Identity?.Name ?? "Utilisateur";
        _initials = string.Concat(_userName.Split(' ', System.StringSplitOptions.RemoveEmptyEntries)
                                           .Take(2)
                                           .Select(p => char.ToUpper(p[0])));
        if (string.IsNullOrEmpty(_initials)) _initials = "?";
        _today = DateTime.Now.ToString("dddd d MMMM yyyy", new System.Globalization.CultureInfo("fr-FR"));
        _today = char.ToUpper(_today[0]) + _today[1..];
    }
}
