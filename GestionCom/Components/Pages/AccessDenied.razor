@page "/access-denied"

<PageTitle>Accès refusé</PageTitle>

<div class="app-page-stack">
    <section class="app-panel">
        <div class="app-page-stack">
            <h1>Accès refusé</h1>
            <p>Vous n'avez pas l'autorisation d'accéder à cette page.</p>
            <div class="app-message app-message-error">Cette section est réservée aux profils autorisés.</div>
            <div class="app-actions app-actions-inline">
                <a href="/" class="app-button">Retour à l'accueil</a>
                <a href="/profil" class="app-button btn-secondary">Voir mon profil</a>
            </div>
        </div>
    </section>
</div>
